# Default deny: new files stay local until explicitly classified as a product file.
*
!/.gitignore
!/.gitattributes
!/start_galbench.bat

# Application source. Harness setup, credentials and development helpers are local.
!/galbench/
!/galbench/*.py
!/galbench/harnesses/
!/galbench/harnesses/*.py

# Browser application and its shipped artwork.
!/galbench/static/
!/galbench/static/*.html
!/galbench/static/*.css
!/galbench/static/*.js
!/galbench/static/*.svg
!/galbench/static/covers/
!/galbench/static/covers/*.jpg
!/galbench/static/covers/catalog.json
!/galbench/static/ai-cast/
!/galbench/static/ai-cast/*.png
!/galbench/static/ai-cast/*.jpg
!/galbench/static/ai-cast/ATTRIBUTION.txt
!/galbench/static/ai-cast/icons/
!/galbench/static/ai-cast/icons/*.svg
!/galbench/static/ai-cast/icons/LICENSE

# Current runtime question bank. Review reports and collection manifests stay local.
!/data/
!/data/dev-v2.0/
!/data/dev-v2.0/text.jsonl
!/data/dev-v2.0/vision.jsonl
!/data/dev-v2.0/story.jsonl
!/data/dev-v2.0/assets/
!/data/dev-v2.0/assets/*.jpg
!/data/dev-v2.0/UPSTREAM_RENPY_NOTICE.txt
!/data/dev-v2.0/UPSTREAM_KATAWA_SHOUJO_NOTICE.txt

# Runtime smoke questions are resources, separate from local test code and specs.
!/spec/
!/spec/v2.0/
!/spec/v2.0/samples.text.jsonl
!/spec/v2.0/samples.vision.jsonl
!/spec/v2.0/samples.story.jsonl
!/spec/v2.0/assets/
!/spec/v2.0/assets/*.jpg
!/spec/v2.0/UPSTREAM_RENPY_NOTICE.txt
!/spec/v2.0/UPSTREAM_KATAWA_SHOUJO_NOTICE.txt

# Explicit local-only boundaries, including files added under allowed directories.
**/__pycache__/
**/node_modules/
**/.venv/
**/venv/
**/.idea/
**/.vscode/
**/.vs/
**/.codex/
**/.agents/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
**/.env
**/.env.*
**/*.local.*
**/*.py[cod]
**/*.log
**/*.tmp
**/*.bak
**/*.swp
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.keystore
**/*credentials*
**/*secret*
**/Thumbs.db
**/.DS_Store
/.qa/
/runs/
/local-assets/
/previews/
/tests/
/test/
/tools/
/scripts/
/configs/
/docs/
/plans/
/.github/
/build/
/dist/
/coverage/
/pyproject.toml
/package.json
/package-lock.json
/uv.lock
/poetry.lock
**/*.md
**/tests/
**/test/
**/test_*.py
**/*_test.py
**/conftest.py

# Public legal notices requested for distribution; development docs stay local.
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/THIRD_PARTY_ASSETS.json
!/licenses/
!/licenses/LobeHub-Icons-MIT.txt
!/licenses/RenPy-TheQuestion-NOTICE.txt
!/licenses/KatawaShoujo-NOTICE.txt
!/licenses/ODbL-1.0.txt
!/licenses/DbCL-1.0.txt
!/licenses/Threejs-MIT.txt

# Public GitHub landing page; other development Markdown stays local.
!/README.md
