* text=auto
.gitignore text eol=lf
.gitattributes text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
# Dataset hashes include raw bytes: never normalize JSONL line endings.
*.jsonl -text whitespace=cr-at-eol
*.svg text eol=lf
*.txt text eol=lf
**/LICENSE text eol=lf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
